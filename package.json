{
  "name": "blst",
  "version": "0.1.0",
  "description": "BLPA live scoring and stat tracking for hockey tournaments",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "sync:leagueapps": "node src/db/sync-leagueapps.js",
    "railway": "bash scripts/railway-setup.sh",
    "factions:import": "node src/db/import-factions.js",
    "db:app-role": "node src/db/create-app-role.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakesatcher/BLST.git"
  },
  "bugs": {
    "url": "https://github.com/jakesatcher/BLST/issues"
  },
  "homepage": "https://github.com/jakesatcher/BLST#readme",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "hls.js": "1.7.3",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
