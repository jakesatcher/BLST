# Postgres connection string
DATABASE_URL="postgresql://blst:blst@localhost:5432/blst"
# Set to "true" to connect with TLS (auto-enabled on Heroku, where DYNO is set)
DATABASE_SSL=""

# HTTP port
PORT=3000

# Master admin token. Send as "Authorization: Bearer <token>" (or x-admin-token,
# matching BLPA Factions). Unset = auth disabled for local development only;
# the app refuses to boot on Heroku without it.
ADMIN_TOKEN=""

# Export API (/api/v1/export/*) is public by default, like the viewer pages.
# Set to "false" to require an API key (any role) for exports.
PUBLIC_EXPORTS="true"

# --- BLPA Factions (ODS) integration ---
# Base URL of the deployed Factions app, e.g. https://blpa-ods.herokuapp.com
FACTIONS_BASE_URL=""
# The Factions app's ADMIN_TOKEN (sent as x-admin-token).
FACTIONS_ADMIN_TOKEN=""
# "true" = push participation points/achievements to Factions automatically
# every time a game in a linked tournament goes final.
FACTIONS_AUTO_SYNC="false"

# Heroku postdeploy: "true" loads the demo tournament on first deploy.
SEED_DEMO="false"

# --- Security (see SECURITY.md) ---
# Local development only: allow changes without ADMIN_TOKEN. Ignored when deployed.
ALLOW_OPEN_DEV=""
# Comma-separated origins allowed to call the API from a browser ("*" = any).
CORS_ORIGINS="*"
# Publishes /.well-known/security.txt, e.g. "mailto:security@example.org".
SECURITY_CONTACT=""
# Let webhooks / link checks reach private networks. Leave unset in production.
ALLOW_PRIVATE_NETWORK_URLS=""
# Rate limits (per IP): RATE_LIMIT_READS_PER_MIN=600 RATE_LIMIT_WRITES_PER_MIN=240
# RATE_LIMIT_IMPORTS_PER_MIN=20 RATE_LIMIT_AUTH_FAILURES=10 MAX_STREAMS_PER_IP=12
