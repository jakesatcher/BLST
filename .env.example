# Postgres connection string
DATABASE_URL="postgresql://blst:blst@localhost:5432/blst"
# Set to "true" to connect with TLS (auto-enabled on Heroku, where DYNO is set)
DATABASE_SSL=""

# HTTP port
PORT=3000

# Setup key for the first global admin account (Account -> Set up admin).
# Until an admin account exists it also works as an admin password
# ("Authorization: Bearer <token>"); after that it's retired and admins sign
# in with email + SMS codes. A deployed server refuses to boot without it
# while no admin account exists.
ADMIN_TOKEN=""
# Break-glass (lost phone): "true" lets ADMIN_TOKEN act as admin again even
# though admin accounts exist. Turn it off again straight away.
ADMIN_TOKEN_BREAK_GLASS=""

# --- Accounts: sign-in with an emailed code + a texted code (MFA) ---
# Keys the code hashes; set it so sign-ins in progress survive restarts.
#   openssl rand -hex 32
AUTH_SECRET=""
# Email (any SMTP provider), e.g. smtps://USER:PASS@smtp.postmarkapp.com:465
SMTP_URL=""
EMAIL_FROM="BLST <no-reply@example.org>"
# SMS via Twilio (From number, or a Messaging Service SID instead).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Calling codes texts may go to (stops SMS-pumping fraud). Default: 1 (US/Canada).
SMS_ALLOWED_COUNTRY_CODES="1"
# Upper limit on texts per hour, all users together.
SMS_MAX_PER_HOUR="300"
# Without email/SMS providers, print codes in the server log. Defaults to on
# locally and off when deployed.
AUTH_LOG_CODES=""
# Host name for the auto-fill line in texts (WebOTP), e.g. blst.example.org.
APP_HOST=""

# Export API (/api/v1/export/*) is public by default, like the viewer pages.
# Set to "false" to require an API key (any role) for exports.
PUBLIC_EXPORTS="true"

# --- BLPA Factions (ODS) integration ---
# Base URL of the deployed Factions app, e.g. https://blpa-ods.herokuapp.com
FACTIONS_BASE_URL=""
# The Factions app's ADMIN_TOKEN (sent as x-admin-token).
FACTIONS_ADMIN_TOKEN=""
# "true" = push participation points/achievements to Factions automatically
# every time a game in a linked tournament goes final.
FACTIONS_AUTO_SYNC="false"

# Heroku postdeploy: "true" loads the demo tournament on first deploy.
SEED_DEMO="false"

# --- Security (see SECURITY.md) ---
# Local development only: allow changes without ADMIN_TOKEN. Ignored when deployed.
ALLOW_OPEN_DEV=""
# Comma-separated origins allowed to call the API from a browser ("*" = any).
CORS_ORIGINS="*"
# Publishes /.well-known/security.txt, e.g. "mailto:security@example.org".
SECURITY_CONTACT=""
# Let webhooks / link checks reach private networks. Leave unset in production.
ALLOW_PRIVATE_NETWORK_URLS=""
# Rate limits (per IP): RATE_LIMIT_READS_PER_MIN=600 RATE_LIMIT_WRITES_PER_MIN=240
# RATE_LIMIT_IMPORTS_PER_MIN=20 RATE_LIMIT_AUTH_FAILURES=10 MAX_STREAMS_PER_IP=12
# RATE_LIMIT_AUTH_STARTS=30 RATE_LIMIT_AUTH_VERIFIES=90 (per 15 minutes)

# --- LeagueApps registrations (Private API) ---
# Admin Dashboard > Connect > API Settings > Private API key (.p12). Convert:
#   openssl pkcs12 -nodes -legacy -in <client-id>.p12 -out <client-id>.pem
# then paste the PEM (newlines may be written as \n on one line).
LEAGUEAPPS_SITE_ID=""
LEAGUEAPPS_CLIENT_ID=""
LEAGUEAPPS_PRIVATE_KEY=""
# Defaults: https://public.leagueapps.io and https://auth.leagueapps.io/v2/auth/token
LEAGUEAPPS_API_BASE=""
LEAGUEAPPS_AUTH_URL=""
# Pull new registrations every N minutes (0 = manual / Heroku Scheduler only).
LEAGUEAPPS_SYNC_INTERVAL_MIN="0"
